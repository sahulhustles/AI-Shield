# =============================================================================
# AIShield - Environment Configuration Template (.env.example)
# Copy this file to .env and configure as needed:
#   cp .env.example .env
# =============================================================================

# --- Application Server ---
PORT=5000
FLASK_DEBUG=0

# --- Ingestion Queue & Background Workers ---
AISHIELD_QUEUE_MAX_SIZE=1000
AISHIELD_WORKER_COUNT=1
AISHIELD_MAX_ATTEMPTS=3
AISHIELD_MAX_TEXT_LENGTH=50000

# --- Threat & Graph Analytics Thresholds ---
AISHIELD_SIMILARITY_THRESHOLD=0.65
AISHIELD_INCIDENT_MIN_THREAT_SCORE=60.0
AISHIELD_INCIDENT_MIN_AI_PROB=0.85
AISHIELD_INCIDENT_SEC_THREAT_SCORE=40.0

# --- Live Telemetry & Server-Sent Events (SSE) ---
MAX_SSE_SUBSCRIBERS=25
SSE_KEEPALIVE_INTERVAL_SECONDS=15.0

# --- Bluesky Live Jetstream Connector ---
BLUESKY_ENABLED=false
BLUESKY_JETSTREAM_URL=wss://jetstream1.us-east.bsky.network/subscribe?wantedCollections=app.bsky.feed.post
BLUESKY_RELEVANCE_FILTER_ENABLED=true
BLUESKY_MONITOR_TERMS=cybersecurity,cyberattack,infosec,informationsecurity,malware,ransomware,phishing,databreach,socialengineering,misinformation,disinformation,propaganda,influenceoperation,informationwarfare,deepfake,aigenerated,misleading,factcheck,scam

# --- Mastodon Live Streaming Connector ---
MASTODON_ENABLED=false
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=
MASTODON_STREAM_MODE=hashtag
MASTODON_HASHTAGS=cybersecurity,cyberattack,infosec,informationsecurity,malware,ransomware,phishing,databreach,socialengineering,misinformation,disinformation,propaganda,influenceoperation,informationwarfare,deepfake,aigenerated,misleading,factcheck,scam

# --- YouTube Data API v3 Keyword Polling Connector ---
YOUTUBE_ENABLED=false
YOUTUBE_API_KEY=
YOUTUBE_QUERIES=cybersecurity threat,disinformation campaign,phishing attack
YOUTUBE_REGION_CODE=US
YOUTUBE_LANGUAGE=en
YOUTUBE_POLL_INTERVAL_SECONDS=300
YOUTUBE_MAX_RESULTS=10
YOUTUBE_MAX_REQUESTS_PER_DAY=100

# --- Graph Neural Network (GNN) Module ---
GNN_ENABLED=true
GNN_MIN_TRAIN_NODES=6
GNN_HIDDEN_DIM=32
GNN_LEARNING_RATE=0.01
GNN_EPOCHS=80
GNN_DROPOUT=0.2
GNN_RANDOM_SEED=42
